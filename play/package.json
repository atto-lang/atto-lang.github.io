{
  "name": "@atto-lang/playground",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A serverless AttoLang source-to-WebAssembly playground",
  "scripts": {
    "vendor:compiler": "sh scripts/vendor-compiler.sh",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:e2e": "node tests/browser-e2e.mjs",
    "verify:candidate": "node tools/verify-compiler-candidate.mjs",
    "verify": "npm test",
    "serve": "python3 -m http.server 8080",
    "verify:actor-pipe-candidate": "node tools/verify-actor-pipeline-v3-candidate.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
