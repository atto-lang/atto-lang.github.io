// Each actor has private state in its own Web Worker.
// The state container and critical-write loan are checked by the compiler.
// main completes before the actor mailbox drains in FIFO order.
define actor Counter as
  state {
    let int total = 0;
  }

  receive(ActorMail<int> mail): void {
    self.handle_state(critical-write |s| -> {
      self.total = self.total + mail.value;
      stdio.println(self.total);
    });
  }
end

pub fnc main(): int {
  val counter = spawn Counter();
  for (let i = 1; i <= 5; i++) {
    counter.send(i);
  }
  stdio.println("main sent 5 messages");
  return 0;
}
