// Actors: independent Wasm instances (including private memories) share a
// tenant Worker. Each mailbox drains in FIFO order after main returns.
define actor Counter as
  let int total = 0;

  receive(ActorMail<int> mail): void {
    self.total = self.total + mail.value;
    stdio.println(self.total);
    return;
  }
end

pub fnc main(): int {
  val counter = spawn Counter();
  for (let i = 1; i <= 5; i++) {
    counter.send(i);
  }
  stdio.println("main sent 5 messages");
  return 0;
}
