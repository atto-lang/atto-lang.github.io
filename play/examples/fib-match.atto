// Recursion and pattern matching: match ... over ... end
fnc fib(int n): int {
  return match n over
    on 0 -> 0,
    on 1 -> 1,
    default ->  fib(n - 1) + fib(n - 2),
  end
}

pub fnc main(): int {
  for (let i = 0; i < 10; i++) do
    stdio.print(fib(i));
    stdio.print(" ");
  done
  stdio.println("");
  return fib(12);
}
