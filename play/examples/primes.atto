// Loops: for, while ... do ... done, continue, break
// Canonical AttoLang removed the remainder operator: this uses repeated subtraction
// divisibility, kept small for browser demonstration.
fnc divides(int n, int d): bool {
  let rest = n;
  while rest >= d do
    rest = rest - d;
  done
  return rest eq 0;
}

fnc is_prime(int n): bool {
  if n < 2 then
    return false;
  fi
  for (let d = 2; d * d <= n; d++) do
    if divides(n, d) then
      return false;
    fi
  done
  return true;
}

pub fnc main(): int {
  let count = 0;
  let n = 0;
  while true do
    n = n + 1;
    if !is_prime(n) then
      continue;
    fi
    count = count + 1;
    stdio.println(n);
    if count eq 10 then
      break;
    fi
  done
  return count;
}
