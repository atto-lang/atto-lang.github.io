// SYNTAX PREVIEW — export/re-export and class access modifiers need compiler
// This preview is not browser-lowered; compile/format/run remain disabled.
// and linker conformance. The formatter preserves export[pkg]/export[file],
// but preserving spelling is NOT proof that the browser compiler accepts it.
// pub exposes an API; internal/protected control scopes; final is single
// assignment. external declarations need an explicitly approved foreign ABI.

define class Account as
  protected final int id: 7;
  private let int balance: 0;

  protected id_value(): int {
    return self.id;
  }

  pub get_balance(): int {
    return self.balance;
  }
end

internal fnc internal_code(): int {
  return 7;
}

external fnc host_clock_ns(): int;

// Illustrative scoped export forms; the formatter knows these spellings.
export[pkg] class {Account};
export[file] type InternalView;

pub fnc main(): int {
  val account = new Account();
  stdio.println(account.get_balance());
  return internal_code();
}
