// SYNTAX PREVIEW — proposed Channel factory; compiler does not lower it.
// A bounded channel with capacity 2: the third send suspends until a receiver
// frees a slot. "Blocking" means suspending the task, NOT blocking its carrier.
// Closing wakes receivers; producer and consumer cooperate on the actor pool.

suspends fnc produce(Channel<int> ch): void {
  for (let i = 1; i <= 3; i++) do
    writech ch, i;
  done
  ch.close();
}

suspends fnc consume(Channel<int> ch): int {
  let total = 0;
  for (let i = 0; i < 3; i++) do
    total += readch ch;
  done
  return total;
}

suspends fnc main(): int {
  val ch = Channel<int>.bounded(2);
  val producer = task {
    return await produce(ch);
  };
  val sum = await consume(ch);
  await producer;
  return sum;  // 6
}
