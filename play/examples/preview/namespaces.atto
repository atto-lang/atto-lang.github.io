// SYNTAX PREVIEW — namespace file headers and imported modules need browser support.
// `use namespace storefront;` declares THIS source file's namespace identity.
// It must precede imports and declarations; namespaces are flat (not dotted).
// It does NOT import another module's members into unqualified lexical lookup.
// The companion ./math.atto (not provided in this single-file playground) would
// declare `define module math as` and export `pub fnc square(int n): int`.
// Importing a module explicitly preserves qualified access (math.square).

use namespace storefront;
import module math from "./math.atto";

pub fnc main(): int {
  stdio.println(math.square(7)); // 49, if the companion module is available
  return 0;
}
