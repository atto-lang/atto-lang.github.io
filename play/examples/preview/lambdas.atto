// SYNTAX PREVIEW — arrow functions and lambdas, not browser-lowered.
// Expression-body syntax returns its expression without "return".
// A braced lambda must return explicitly on every non-void path.
// Lexical captures are ownership-checked and must not escape unsafe borrows.

fnc make_adder(int offset): Fnc<int, int> {
  return |int value| -> value + offset;
}

pub fnc main(): int {
  val Fnc<int, int> double_it = |int value| -> {
    return value * 2;
  };
  val plus_one = make_adder(1);
  stdio.println(double_it(21)); // 42
  stdio.println(plus_one(41)); // 42
  return 0;
}
