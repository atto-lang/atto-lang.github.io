// LANGUAGE PREVIEW — compiles and runs in this browser playground.
// Runs on the pinned Rust/Wasm compiler; Java/LLVM parity is not claimed.
// Bounded nonescaping direct lambdas with immutable int captures and direct calls.
// This does NOT provide first-class callable storage, returned closures or
// higher-order function arguments; see lambdas-advanced for syntax-only designs.
fnc doubled(int value): int {
  val factor = 2;
  val multiply = |n| : int -> n * factor;
  return multiply(value);
}

fnc constant_answer(): int {
  val answer = || -> 42;
  return answer();
}

pub fnc main(): int {
  val offset = 1;
  val add_offset = |n| : int -> n + offset;
  val first = add_offset(41);
  val second = doubled(21);
  val third = constant_answer();
  stdio.println(first);
  stdio.println(second);
  stdio.println(third);
  return first + second + third; // 126
}
