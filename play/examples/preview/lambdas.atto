// SYNTAX PREVIEW — full closures, functors and lambdas are not browser-lowered.
// Lambda: an anonymous function; double_it captures no outer variables.
// Closure: a lambda retaining its lexical environment (the copyable int offset).
// Functor: a class instance with a named call method, invoked as obj.call(n).
// Callable type fnc(int) => int and indirect calls are proposed, not executable here.
// Captures must not let borrowed values or sealed actor-state loans escape.
// This example is illustrative; execution and cross-backend parity are unverified.

fnc apply_twice(fnc(int) => int operation, int value): int {
  return operation(operation(value));
}

fnc make_adder(int offset): fnc(int) => int {
  return |n| : int -> n + offset;
}

define class Multiplier as
  int factor;

  constructor(int factor) {
    self.factor = factor;
  }

  pub call(int value): int {
    return value * self.factor;
  }
end

pub fnc main(): int {
  // Inferred parameter and return types are checked against context.
  val double_it = |n| : int -> n * 2;
  // A braceless, explicitly typed return statement ends with a semicolon.
  val is_positive = |n| : bool -> return n > 0;
  val plus_one = make_adder(1);
  val triple = new Multiplier(3);

  stdio.println(double_it(21));       // 42 — lambda
  stdio.println(plus_one(41));        // 42 — capturing closure
  stdio.println(triple.call(14));     // 42 — functor via explicit call
  stdio.println(is_positive(42));     // true
  stdio.println(apply_twice(double_it, 10)); // 40 — higher-order function
  return 0;
}
