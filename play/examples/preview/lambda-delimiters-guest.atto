// LANGUAGE PREVIEW — compiles and runs in this browser playground.
// Runs on the pinned Rust/Wasm compiler; Java/LLVM parity is not claimed.
// The existing compiler supports direct, nonescaping lambdas with explicit
// ||, |_| and |n| parameter lists. This is not a claim of general
// const fnc bindings, advanced typed parameters, or first-class closures.
// Spec target: https://github.com/atto-lang/atto-spec/pull/192

pub fnc main(): int {
  val ignore_one = |_| : int -> 5;
  val no_args = || -> 7;
  val twice = |n| : int -> n * 2;
  return ignore_one(100) + no_args() + twice(15); // 42
}

// INVALID: val constant = _ : int -> 5; // delimiter-free lambda rejected
// INVALID: ignore_one();                 // missing required argument
// INVALID: no_args(1);                   // zero-argument arity mismatch
