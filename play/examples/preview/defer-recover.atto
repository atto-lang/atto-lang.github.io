// LANGUAGE PREVIEW — compiles and runs in this browser playground.
// Runs on the pinned Rust/Wasm compiler; Java/LLVM parity is not claimed.
//
// defer is registered now, executed LIFO exactly once on unwind/return.
// recover callbacks are invoked only for raise or throw escaping all matching
// catch clauses in the active caller chain. panic/cancellation always bypass.
// On a handled failure, recovery returns the invocation's result; it does
// NOT resume execution after the failing statement.
//
// Expected: recover_raise() = 9, recover_escaped_throw() = 12,
//           catch_before_recover() = 21; catch_in_outer_caller() = 21.
// main() = 63: all four paths actually run once.

fnc raise_failure(): int raises(Error) {
  raise new Error("escalated failure");
}

// Matching catch must not intercept raise; finally and defer still run.
fnc recover_raise(): int {
  recover (|string context| -> |err, c| -> {
    stdio.println(context);
    return 9;
  })("recovering raise");

  defer || -> { stdio.println("raise cleanup B"); };
  defer || -> { stdio.println("raise cleanup A"); };

  try {
    return raise_failure();
  } catch (Error e) {
    return -1; // Never reached for raise.
  } finally {
    stdio.println("raise finally");
  }
}

fnc inner_throw(): int throws(Error) {
  throw new Error("ordinary throw");
}

fnc intermediate(): int throws(Error) {
  return inner_throw();
}

// No matching catch anywhere in the call chain: throw reaches recover.
fnc recover_escaped_throw(): int {
  recover (|string context| -> |err, c| -> {
    stdio.println(context);
    return 12;
  })("recovering unhandled throw");

  defer || -> { stdio.println("throw cleanup"); };
  return intermediate();
}

// A matching catch consumes throw before any recover callback runs.
fnc catch_before_recover(): int {
  recover (|string context| -> |err, c| -> {
    stdio.println("UNEXPECTED recovery: " + context);
    c.next(); // Terminal delegation, not a retry.
  })("must stay unused");

  defer || -> { stdio.println("caught cleanup"); };
  try {
    return inner_throw();
  } catch (Error e) {
    return 21;
  } finally {
    stdio.println("caught finally");
  }
}

// The throw escapes the callee, but is caught further up the caller chain.
// This catches a subtle incorrect implementation: an inner recover callback
// MUST NOT steal the throw before the outer caller's matching catch.
fnc callee_with_recover(): int throws(Error) {
  recover (|string context| -> |err, c| -> {
    stdio.println("UNEXPECTED callee recover: " + context);
    return -10;
  })("outer catch has priority");
  throw new Error("caller catches this");
}

fnc catch_in_outer_caller(): int {
  try {
    return callee_with_recover();
  } catch (Error e) {
    return 21; // Not -10: the callee's recovery handler must not execute.
  }
}

pub fnc main(): int {
  return recover_raise() + recover_escaped_throw()
    + catch_before_recover() + catch_in_outer_caller(); // 63
}
