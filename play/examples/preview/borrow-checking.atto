// SYNTAX PREVIEW — ownership operators are NOT browser-lowered in the pinned public compiler.
// This positive example now has a real Rust/native and wasm32 compiler test
// in an unmerged candidate. No public compiler binary has been promoted.
// The candidate supports lexical class loans and primitive copy!/share!,
// NOT general Arc, class sharing, cross-actor references or suspension loans.
//
// Intended rules: two immutable loans can coexist; an exclusive mutable loan
// cannot overlap either read or another write loan. Loans must not escape.
// Copy is allowed for copyable types only. take! consumes the owner.
// share! requires shareability and thread-safety checks, not raw mutable aliases.

define class Parcel as
  pub let int value = 42;
end

pub fnc main(): int {
  let parcel = new Parcel();

  // Two immutable loans: readers coexist without transferring ownership.
  block {
    val first = borrow! parcel;
    val second = borrow! parcel;
    stdio.println(first.value + second.value); // 84
  } // both read loans end at this block boundary

  // An exclusive mutable loan; the owner must not be accessed concurrently.
  block {
    val writer = borrow! mut parcel;
    writer.value = 43;
  }

  // The compiler accepts copyable types only for copy!/share!.
  val source_number = 21;
  val copied = copy! source_number;

  // take! transfers ownership; the original owner is moved.
  val moved = take! parcel;
  stdio.println(moved.value); // 43

  // share! is limited to verified immutable scalar values in this candidate.
  val shared_number = share! 42;
  return copied + shared_number; // 63
}

// INVALID EXAMPLES — deliberately commented out (each must be diagnosed):
// val gone = take! moved;
// stdio.println(moved.value); // use after take
//
// val reader = borrow! moved;
// val writer = borrow! mut moved; // conflicting loans
//
// val uncopyable = copy! new Parcel(); // class lacks an explicit Copy contract
//
// fnc bad_loan(): Parcel {
//   val local = new Parcel();
//   val reader = borrow! local;
//   return reader; // borrow cannot escape its local owner
// }
//
// val unsafe_shared = share! borrow! mut moved;
// // Class and mutable alias sharing across actors/tenants remains unsupported.
//
// Future tests must reject loans crossing await/select and other effects.
// This is not an authorization to publish a new compiler binary.

// PROPOSED CONTAINERS — source-only teaching examples; NOT runnable in the pinned public compiler
// // SYNTAX PREVIEW — borrow!/copy!/take!/share! and ownership containers are not browser-lowered.
// // This is a proposed teaching example, NOT an implementation guaranteed by the pinned compiler.
// // borrow! creates a scoped, non-owning loan; no loan may outlive its owner or cross an
// // await/select boundary without the compiler proving an appropriate pinned lifetime.
// // copy! requires a Copy-capable value; it does not deep-copy an arbitrary Box<T>.
// // take! transfers ownership and invalidates the source binding until reinitialized.
// // share! is shown for a shared Arc<T> handle, not for mutable aliasing of raw T.
// // Box<T> owns one heap allocation; Arc<T> shares ownership, not mutable access.
// // Send is a transfer-safety type bound, not a container or serialization format.
// // Atomic<T> is for explicitly atomic operations, not general unsynchronized mutation.
// // Constructor, trait-bound and atomic method spellings require spec/compiler conformance.
//
