// SYNTAX PREVIEW — explicit ownership operators are NOT browser-lowered.
// This example is illustrative, not executable in the pinned Wasm compiler.
// borrow!, borrow_mut!, copy!, take!, and share! need parser/typechecker tests.
// Actual Rust/Wasm compiler support is currently a narrower implicit move subset.
//
// Intended rules: two immutable loans can coexist; an exclusive mutable loan
// cannot overlap either read or another write loan. Loans must not escape.
// Copy is allowed for copyable types only. take! consumes the owner.
// share! requires shareability and thread-safety checks, not raw mutable aliases.

define class Parcel as
  pub int value: 42
end

pub fnc main(): int {
  val parcel = new Parcel();

  // Two immutable loans: the parcel remains owned by 'parcel'.
  {
    val read_one = borrow!(parcel);
    val read_two = borrow!(parcel);
    stdio.println(read_one.value + read_two.value); // 84
  } // both loans end before the next exclusive loan

  // Exclusive mutable loan: no read/write overlap is permitted.
  {
    val writer = borrow_mut!(parcel);
    writer.value = 43;
  }

  // copy! preserves the source but requires an explicitly copyable type.
  val source_number = 21;
  val copied_number = copy!(source_number);
  stdio.println(source_number + copied_number); // 42

  // take! transfers the object: the old owner is moved and may not be used.
  val moved_parcel = take!(parcel);
  stdio.println(moved_parcel.value); // 43

  // share! is a proposed explicit shared handle, not a mutable alias escape.
  val shared_number = share!(42);
  val view = borrow!(shared_number);
  stdio.println(view);
  return 0;
}

// INVALID EXAMPLES — deliberately commented out (each must be diagnosed):
// val gone = take!(moved_parcel);
// stdio.println(moved_parcel.value); // use after take
//
// val reader = borrow!(moved_parcel);
// val writer = borrow_mut!(moved_parcel); // conflicting loans
//
// val uncopyable = copy!(new Parcel()); // class lacks an explicit Copy contract
//
// fnc bad_loan(): Borrow<Parcel> {
//   val local = new Parcel();
//   return borrow!(local); // borrow cannot escape a local owner
// }
//
// val unsafe_shared = share!(borrow_mut!(moved_parcel));
// // Must reject unapproved mutable alias sharing across actors/tenants.
//
// Future tests must also reject taking an owner while borrowed and unpinned
// loans crossing await/select. These examples assert no shipping runtime API.
