// SYNTAX PREVIEW — actor state is sealed, actor-owned, and not public fields.
// Actor mutable state is created by a state { ... } container, and accessed
// only inside handle_state critical-read / critical-write callbacks.
// The callback cannot return a state reference, escape a loan, or suspend
// while retaining exclusive mutable access. These are NOT browser-lowered.

define actor Counter as
  state {
    let int count;
  }

  on_start(): void {
    self.count = 0; // initialization hook; not external direct state access
  }

  receive(ActorMail<int> mail): void {
    val next = self.handle_state(critical-write |s| -> {
      s.count += mail.value;
      return s.count;
    });
    val observed = self.handle_state(critical-read |s| -> s.count);
    stdio.println(observed);
  }
end

pub fnc main(): int {
  val counter = spawn Counter();
  counter.send(1);
  return 0;
}
