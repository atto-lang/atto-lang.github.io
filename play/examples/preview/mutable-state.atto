// SYNTAX PREVIEW — actor state is sealed, NOT browser-lowered.
// The state { } container belongs to its actor; it is not a public field set.
// All accesses, including initialization, go through self.handle_state.
// critical-read admits an immutable view; critical-write admits one writer.
// No state-backed loan may escape its callback or survive await/select.
// Direct self.count access and actor-to-actor field access are forbidden.
// The callback/effect grammar needs explicit cross-backend admission tests.

define actor Counter as
  state {
    let int count;
  }

  on_start(): void using state.write {
    self.handle_state(critical-write |s| -> {
      s.count = 0;
    });
  }

  receive(ActorMail<int> mail): void using state.read, state.write {
    self.handle_state(critical-write |s| -> {
      s.count += mail.value;
    });
    val observed = self.handle_state(critical-read |s| -> s.count);
    stdio.println(observed);
  }
end

pub fnc main(): int {
  val counter = spawn Counter();
  counter.send(1); // mailbox admission, not execution completion
  return 0;
}
