// PREVIEW ONLY: generators/yield are not yet lowered by the browser compiler.
// Explicit *gen declaration preview; generator ownership and cancellation need conformance.
fnc *gen count_to(int limit): Generator<int> {
  for (let i = 1; i <= limit; i++) do
    yield i;
  done
}

pub fnc main(): int {
  let sum = 0;
  for value in count_to(4) do
    sum += value;
  done
  stdio.println(sum); // 10
  return sum;
}
