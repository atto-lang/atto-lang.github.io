// SYNTAX PREVIEW — routine is a direct-call-only named callable.
// This preview is not browser-lowered; compile/format/run remain disabled.
// This sample intentionally uses a nonrecursive routine. The Java reference
// currently allows recursion in routines, so a "no recursion" rule must be
// specified and checked separately; do not claim it is already enforced.
// Unlike fnc, a routine is not reified as a first-class callback value.

routine square(int value): int {
  return value * value;
}

fnc twice(int value): int {
  return value * 2;
}

fnc apply(Fnc<int, int> callback, int value): int {
  return callback(value);
}

pub fnc main(): int {
  stdio.println(square(7));
  stdio.println(apply(twice, 21));
  // INVALID: apply(square, 7); a routine is not a callable value.
  return 0;
}
