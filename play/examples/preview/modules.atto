// SYNTAX PREVIEW — named modules and cross-file imports are not browser-lowered.
// `define module` introduces a named declaration; exports are `pub` members.
// Members without `pub` are private by default.
// A separate file could import this with:
//   import module Arithmetic from "./arithmetic.atto";
// Project-root + imports require separate resolver conformance tests.

define module Arithmetic as
  pub fnc double(int value): int {
    return value * 2;
  }
end

define module Internal as
  fnc private_increment(int value): int {
    return value + 1;
  }
end

pub fnc main(): int {
  stdio.println(Arithmetic.double(21)); // 42
  return 0;
}
