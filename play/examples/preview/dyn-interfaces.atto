// SYNTAX PREVIEW — NOT browser-lowered by the currently pinned compiler.
// Proposed owned Dyn<T> candidate: one verified local implementing class only.
// Multi-implementation dynamic dispatch still requires an approved runtime ABI.
// Dyn<T> is a proposed type-erased, interface-constrained value; it is NOT Any,
// reflection, an unchecked cast, or permission to bypass a TenantVM boundary.
// General dynamic dispatch requires validated method tables and provenance;
// the first compiler candidate uses restricted monomorphic devirtualization.
// Erasure does not confer Sendable or Serializable.
//
// This constructor illustrates checked OWNED erasure. Borrowed Dyn views,
// lifetimes, polymorphic object layout and dispatch ABI remain under review.
define pub interface Printable as
  describe(): string;
end

define class Greeting implements Printable as
  pub describe(): string { return "hello"; }
end

fnc display(Dyn<Printable> item): string {
  return item.describe(); // constrained dynamic dispatch, not arbitrary access
}

pub fnc main(): int {
  val Greeting concrete = new Greeting();
  val Dyn<Printable> erased = Dyn<Printable>(take! concrete);
  // INVALID: concrete.describe(); // use after transfer
  // INVALID: val Dyn<Printable> forged = Dyn<Printable>(42); // no implementation
  // INVALID: erased.secret_field; // not declared by Printable
  // INVALID: send_to_other_tenant(erased); // no ambient cross-tenant authority
  stdio.println(display(erased)); // expected output: hello
  return 0;
}
