// PREVIEW ONLY: the pinned browser compiler does not yet accept these operators.
// Canonical intent: && AND, || OR, ^^ XOR; no single | or & boolean operators.
// And(a,b), Or(a,b), Xor(a,b) are supported compatibility functions.
pub fnc main(): int {
  val a = true;
  val b = false;
  stdio.println(a && b);
  stdio.println(a || b);
  stdio.println(a ^^ b);
  stdio.println(And(a, b));
  stdio.println(Or(a, b));
  stdio.println(Xor(a, b));
  // Requested word-form aliases (pending lexer/compiler support):
  // stdio.println(a AND b);
  // stdio.println(a OR b);
  // stdio.println(a XOR b);
  return 0;
}
