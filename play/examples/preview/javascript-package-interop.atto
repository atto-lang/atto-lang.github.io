import module dates from pkg 'npm:date-fns';

fnc normalized(string iso): Result<string, Error> {
  return dates.format_iso_date(iso);
}

pub fnc main(): int {
  val output = normalized("2026-11-20");
  stdio.println(output);
  return 0;
}
