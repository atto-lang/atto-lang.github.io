// PREVIEW ONLY: the function pipeline '|>' is not lowered by the browser compiler.
// The left value flows into the next ordinary function call.
fnc twice(int x): int { return x * 2; }
fnc add_three(int x): int { return x + 3; }
fnc square(int x): int { return x * x; }

pub fnc main(): int {
  val answer = 4 |> twice |> add_three |> square;
  stdio.println(answer); // 121
  return answer;
}
