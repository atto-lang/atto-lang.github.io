// LANGUAGE PREVIEW — compiles and runs in this browser playground.
// Runs on the pinned Rust/Wasm compiler; Java/LLVM parity is not claimed.
// The executable ? subset handles Result<int,string> and Option<int> only.
// Err and None propagate early without panic or host-JavaScript simulation.
// General Result<int,Error>, int.parse and generic ADT ? remain unverified.
fnc read_number(bool accepted): Result<int,string> {
  if !accepted then return Err("rejected"); fi
  return Ok(40);
}

fnc calculate(bool accepted): Result<int,string> {
  val value: int = read_number(accepted)?;
  return Ok(value + 2);
}

fnc read_option(bool present): Option<int> {
  if !present then return None; fi
  return Some(12);
}

fnc next_option(bool present): Option<int> {
  val value: int = read_option(present)?;
  return Some(value + 1);
}

pub fnc main(): int {
  match calculate(false) over
    on Ok(value) -> { return -1; }
    on Err(message) -> { stdio.println(message); }
  end
  match calculate(true) over
    on Ok(value) -> { stdio.println(value); }
    on Err(message) -> { return -2; }
  end
  match next_option(false) over
    on Some(value) -> { return -3; }
    on None -> { stdio.println("absent"); }
  end
  match next_option(true) over
    on Some(value) -> { stdio.println(value); return 42; }
    on None -> { return -4; }
  end
}
// INVALID: postfix ? used in a plain int-returning function.
// INVALID: propagating Result<int,string> from an Option<int> function.
// INVALID: general unverified Result<int,Error> propagation.
