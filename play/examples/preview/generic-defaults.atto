// Defaulted generic arguments and named specialization require AOT monomorphization tests.
fnc identity<T=int>(T value): T { return value; }
fnc choose<A=int, B=bool>(A value, B enabled): A {
  if enabled then return value; fi
  return value;
}
pub fnc main(): int {
  val a = identity(41);
  val b = choose<B=bool, A=int>(42, true);
  return a + b - 41;
}
