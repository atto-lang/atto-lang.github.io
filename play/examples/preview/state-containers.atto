// SYNTAX PREVIEW — standalone mutable state containers are not browser-lowered.
// This proposed "define state container" contract is distinct from actor-owned state.
// State fields are sealed: clients cannot read or write counter.count directly.
// critical is an exclusive scoped state loan; critical-write explicitly requests a
// writer, while critical-read permits concurrent immutable readers.
// The callback must not leak s or a field reference, await/select, or invoke
// unproved effects. Release is required on every exit, including errors/cancel.
// Container construction, implicit handle_state, lock fairness, and executable
// compiler/runtime semantics still require conformance tests. Do not advertise
// this example as runnable with the pinned browser Wasm compiler.

define state container Counter as
  state {
    let int count: 0;
  }

  increment(int amount): void {
    handle_state(critical |s| -> {
      s.count = s.count + amount;
    });
  }

  reset(): void {
    handle_state(critical-write |s| -> {
      s.count = 0;
    });
  }

  read_count(): int {
    return handle_state(critical-read |s| -> s.count);
  }
end

pub fnc main(): int {
  val counter = Counter(); // Proposed construction; NOT executable in browser.
  counter.increment(2);
  stdio.println(counter.read_count()); // Intended: 2
  counter.reset();
  stdio.println(counter.read_count()); // Intended: 0
  return 0;
}
