// PREVIEW ONLY: package linking, scoped using, timeout and suspension need compiler/runtime support.
// The span remains alive during await; cleanup must occur exactly once on every scope exit.
import span from pkg "core.telemetry";
import sleep from pkg "std.time";

pub suspends fnc main(): int {
  using span("playground.demo") as current_span {
    with timeout(2000) {
      current_span.set_attribute("feature", "import");
      await sleep(1);
      stdio.println("span retained over suspension");
    }
  }
  return 0;
}
