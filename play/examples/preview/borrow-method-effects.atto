define class Account as
  pub let string label = "savings";
  pub let int total = 40;
end

// TARGET: the typed body may yield reads/writes={self.total} after validation.
// Overrides, callbacks, generic instantiations and dynamic dispatch must be checked.
mtd (mut self: Account) increment_total(): void {
  self.total += 1;
}

mtd (self: Account) read_total(): int {
  return self.total;
}

pub fnc main(): int {
  val mut Account account = new Account();
  val label_view = borrow! account.label;
  account.increment_total(); // TARGET: allowed ONLY with verified disjoint effects
  val label_seen = label_view; // the readonly field loan is live through this use
  account.label = "updated"; // NLL: permitted after last possible use
  return account.read_total() + 1; // intended 42; NOT browser execution evidence
}

