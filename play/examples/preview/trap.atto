// SYNTAX PREVIEW — expression trap, Option and Result are not browser-lowered.
// A caller writes "trap expression" to catch an ordinary throw as Option<T>.
// Success becomes Some(value); an uncaught ordinary throw becomes None.
// Err(...) is Result data: trap checked_id(-1) yields Some(Err(...)), NOT None.
// The trap layer never flattens a Result or an Option.
// raise, panic and cancellation bypass trap.

fnc checked_id(int id): Result<int, String> {
  if id < 0 then
    return Err("id must be nonnegative");
  fi
  return Ok(id);
}

fnc print_checked(Option<Result<int, String>> outcome): void {
  match outcome over
    on Some(result) -> {
      match result over
        on Ok(id) -> { stdio.println(id); }
        on Err(message) -> { stdio.println(message); }
      end
    }
    on None -> { stdio.println("an ordinary throw was caught"); }
  end
  return;
}

pub fnc main(): int {
  val Option<Result<int, String>> success = trap checked_id(5);
  val Option<Result<int, String>> invalid = trap checked_id(-1);

  print_checked(success);  // Some(Ok(5))
  print_checked(invalid);  // Some(Err("id must be nonnegative"))
  return 7;
}
