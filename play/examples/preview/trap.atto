// SYNTAX PREVIEW — trap, Option and Result are not browser-lowered.
// A trap fnc declares a callable whose calls yield Option<T>.
// Only an uncaught ordinary throw becomes None; Err is still Result data.
// A Result return therefore produces Option<Result<T, E>> (no flattening).
// raise, panic and cancellation bypass trap instead of becoming None.

trap fnc checked_id(int id): Result<int, String> {
  if id < 0 then
    return Err("id must be nonnegative");
  fi
  return Ok(id);
}

fnc print_checked(Option<Result<int, String>> outcome): void {
  match outcome over
    on Some(result) -> {
      match result over
        on Ok(id) -> { stdio.println(id); }
        on Err(message) -> { stdio.println(message); }
      end
    }
    on None -> { stdio.println("ordinary throw during checked_id"); }
  end
  return;
}

pub fnc main(): int {
  print_checked(checked_id(7));   // Some(Ok(7))
  print_checked(checked_id(-1));  // Some(Err("id must be nonnegative"))
  return 7;
}
