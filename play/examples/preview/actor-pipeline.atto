// PREVIEW ONLY: actor pipe '|' is NOT boolean OR, and not function '|>'.
// A message passes through 3 actor mailboxes with bounded backpressure.
define actor Parse as
  receive(ActorMail<int> mail): void {
    emit(mail.value + 1);
  }
end

define actor Validate as
  receive(ActorMail<int> mail): void {
    if mail.value > 0 then emit(mail.value); fi
  }
end

define actor Sink as
  receive(ActorMail<int> mail): void {
    stdio.println(mail.value);
  }
end

pub fnc main(): int {
  val pipeline = spawn Parse() | spawn Validate() | spawn Sink();
  pipeline.send(41); // Sink receives 42, in FIFO order.
  return 0;
}
