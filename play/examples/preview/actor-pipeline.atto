// PREVIEW ONLY: actor pipelines use 'pipe' or '|', not function '|>'.
// Each independent pipeline routes through three actor mailboxes.
// Neither spelling is executable in the pinned browser compiler yet.
define actor Parse as
  receive(ActorMail<int> mail): void {
    emit(mail.value + 1);
  }
end

define actor Validate as
  receive(ActorMail<int> mail): void {
    if mail.value > 0 then emit(mail.value); fi
  }
end

define actor Sink as
  receive(ActorMail<int> mail): void {
    stdio.println(mail.value);
  }
end

pub fnc main(): int {
  // Symbolic actor-pipeline spelling.
  val pipeline_symbols = spawn Parse() | spawn Validate() | spawn Sink();
  pipeline_symbols.send(41); // First Sink receives 42.

  // Keyword actor-pipeline spelling (not a function '|>' pipeline).
  val pipeline_keyword = spawn Parse() pipe spawn Validate() pipe spawn Sink();
  pipeline_keyword.send(41); // Second Sink receives 42.

  return 0;
}
