// Conditions: ',' is AND and '|' is OR; there is no truthiness
// Conditions evaluate both operands eagerly, left-to-right.
fnc is_even(int n): bool {
  let rest = n;
  while rest >= 2 do
    rest = rest - 2;
  done
  return rest eq 0;
}

fnc classify(int n): int {
  if n < 0 then
    return -1;
  elif n eq 0 then
    return 0;
  else
    return 1;
  fi
}

pub fnc main(): int {
  val a = 7;
  val b = 12;
  if a > 0, b > 0 then
    stdio.println("both positive");
  fi
  if is_even(a) | is_even(b) then
    stdio.println("at least one even");
  fi
  val bigger = a > b ? a : b;
  return bigger + classify(-5);
}
