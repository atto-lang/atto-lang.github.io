// LANGUAGE PREVIEW — async generators / for-await are not browser-compiled.
// The iterator suspends between yields; consumers apply backpressure on await.
async fnc pages(): AsyncGenerator<int> {
  for (let i = 1; i <= 3; i++) {
    suspend;
    yield i;
  }
}

pub async fnc main(): int {
  let total = 0;
  for await (val page of pages()) {
    total = total + page;
  }
  return total; // 6
}
