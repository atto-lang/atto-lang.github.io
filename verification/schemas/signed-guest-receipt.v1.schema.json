{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atto-lang.github.io/verification/schemas/signed-guest-receipt.v1.schema.json",
  "title": "AttoLang externally attested guest-execution receipt v1",
  "description": "The Ed25519 signature covers domain-separated canonical payload bytes; validation requires a separate, operator-controlled trust policy and a fresh metadata snapshot. Signature validity is not release certification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "key_id", "payload", "signature"],
  "properties": {
    "schema": {"const": "attolang.signed-guest-receipt.v1"},
    "algorithm": {"const": "Ed25519"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend","feature","repository","pr","head_sha","tree_sha","ci_repository","mirror_repository","mirror_commit_sha","mirror_tree_sha","workflow_id","run_id","job_id","run_head_sha","run_attempt","job_run_attempt","runner","runner_os","artifact_name","artifact_sha256","contract_id","contract_version","receipt_id","nonce","issued_at","expires_at","guest_execution_mode","guest_runtime_id","guest_binary_sha256","execution_log_sha256","guest_result_sha256","executed_cases","test_kind","test_result","contract_result"],
      "properties": {
        "backend": {"enum": ["Java/GraalVM","LLVM","Wasm","Forge/Cranelift",".NET"]},
        "feature": {"type":"string","minLength":1,"maxLength":80},
        "repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pr": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "head_sha": {"type":"string","pattern":"^[a-f0-9]{40}$"},
        "tree_sha": {"type":"string","pattern":"^[a-f0-9]{40}$"},
        "ci_repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "mirror_repository": {"type":"string","pattern":"^(|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$"},
        "mirror_commit_sha": {"type":"string","pattern":"^(|[a-f0-9]{40})$"},
        "mirror_tree_sha": {"type":"string","pattern":"^(|[a-f0-9]{40})$"},
        "workflow_id": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "run_id": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "job_id": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "run_head_sha": {"type":"string","pattern":"^[a-f0-9]{40}$"},
        "run_attempt": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "job_run_attempt": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "runner": {"type":"string","minLength":1,"maxLength":200},
        "runner_os": {"type":"string","minLength":1,"maxLength":100},
        "artifact_name": {"type":"string","minLength":1,"maxLength":150},
        "artifact_sha256": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "contract_id": {"type":"string","pattern":"^[A-Za-z0-9._:-]{1,120}$"},
        "contract_version": {"type":"string","pattern":"^[A-Za-z0-9._-]{1,60}$"},
        "receipt_id": {"type":"string","pattern":"^[a-f0-9]{32}$"},
        "nonce": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "issued_at": {"type":"string","format":"date-time"},
        "expires_at": {"type":"string","format":"date-time"},
        "guest_execution_mode": {"enum":["native-aot","jvm-guest","wasm-runtime","browser-worker","forge-guest","dotnet-native-aot"]},
        "guest_runtime_id": {"type":"string","pattern":"^[A-Za-z0-9._:-]{1,120}$"},
        "guest_binary_sha256": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "execution_log_sha256": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "guest_result_sha256": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "executed_cases": {"type":"string","pattern":"^[1-9][0-9]{0,18}$"},
        "test_kind": {"const":"guest"},
        "test_result": {"const":"passed"},
        "contract_result": {"const":"passed"}
      }
    }
  }
}
