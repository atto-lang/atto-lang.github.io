{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atto-lang.github.io/verification/schemas/metadata-snapshot.v1.schema.json",
  "title": "AttoLang Source-Free Advisory Metadata Snapshot v1",
  "description": "Untrusted metadata-only snapshot. Not guest-execution evidence or a release certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "collected_at",
    "release_certification",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "attolang.metadata-snapshot.v1"
    },
    "mode": {
      "const": "read-only-source-free"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_certification": {
      "const": "NOT_CERTIFIED"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "feature",
          "repository",
          "pr",
          "head_sha",
          "tree_sha",
          "ci_repository",
          "workflow_id",
          "run_id",
          "job_id",
          "run_head_sha",
          "run_attempt",
          "job_run_attempt",
          "run_status",
          "run_conclusion",
          "job_conclusion",
          "runner",
          "runner_os",
          "runner_type",
          "artifact_name",
          "artifact_sha256",
          "artifact_expires_at",
          "contract_id",
          "contract_version",
          "contract_result",
          "test_kind",
          "test_result",
          "review_state",
          "reviewer",
          "review_head_sha",
          "pr_author",
          "evidence_at",
          "notes"
        ],
        "properties": {
          "backend": {
            "enum": [
              "Java/GraalVM",
              "LLVM",
              "Wasm",
              "Forge/Cranelift",
              ".NET"
            ]
          },
          "feature": {
            "type": "string",
            "maxLength": 400
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "pr": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "tree_sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "ci_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "workflow_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "run_head_sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "run_attempt": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "job_run_attempt": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "run_status": {
            "const": "completed"
          },
          "run_conclusion": {
            "const": "success"
          },
          "job_conclusion": {
            "const": "success"
          },
          "runner": {
            "type": "string",
            "maxLength": 400
          },
          "runner_os": {
            "type": "string",
            "maxLength": 400
          },
          "runner_type": {
            "type": "string",
            "maxLength": 400
          },
          "artifact_name": {
            "type": "string",
            "maxLength": 400
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$"
          },
          "artifact_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "contract_id": {
            "type": "string",
            "maxLength": 400
          },
          "contract_version": {
            "type": "string",
            "maxLength": 400
          },
          "contract_result": {
            "const": "not_executed"
          },
          "test_kind": {
            "const": "none"
          },
          "test_result": {
            "const": "not_executed"
          },
          "review_state": {
            "enum": [
              "approved",
              "pending"
            ]
          },
          "reviewer": {
            "type": "string",
            "maxLength": 400
          },
          "review_head_sha": {
            "type": "string",
            "pattern": "^(|[a-fA-F0-9]{40})$"
          },
          "pr_author": {
            "type": "string",
            "maxLength": 400
          },
          "evidence_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 400
          },
          "mirror_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "mirror_commit_sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "mirror_tree_sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mirror_repository"
              ]
            },
            "then": {
              "required": [
                "mirror_commit_sha",
                "mirror_tree_sha"
              ]
            }
          },
          {
            "if": {
              "required": [
                "mirror_commit_sha"
              ]
            },
            "then": {
              "required": [
                "mirror_repository",
                "mirror_tree_sha"
              ]
            }
          },
          {
            "if": {
              "required": [
                "mirror_tree_sha"
              ]
            },
            "then": {
              "required": [
                "mirror_repository",
                "mirror_commit_sha"
              ]
            }
          }
        ]
      }
    }
  }
}
